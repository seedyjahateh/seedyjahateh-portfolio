# Build determinism: this repository is authored on Windows and built on Linux CI.
# PRD 5.1.3 requires byte-identical artifacts from identical normalized inputs.
# Line-ending drift silently breaks that guarantee, so normalize everything to LF.
* text=auto eol=lf

# Binary artifacts must never be line-ending normalized.
*.bin      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.avif     binary
*.webp     binary
*.woff     binary
*.woff2    binary
*.pdf      binary
*.ico      binary

# Generated artifacts: collapse in diffs but still reviewed by CI clean-diff checks.
content/schema/**   linguist-generated=true
pnpm-lock.yaml      linguist-generated=true merge=binary
