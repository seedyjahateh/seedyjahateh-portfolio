{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false
  },
  "include": [
    "packages/*/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    // Root config files. Included so type-aware ESLint can resolve them;
    // without this they fail with "not found by the project service".
    "*.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
