        { "id": "count", "label": "count", "aliases": ["n", "items"], "order": 40, "since": 1, "dimension": "count", "toBase": 1 },

        { "id": "bytes", "label": "bytes", "aliases": ["b"], "order": 50, "since": 1, "dimension": "data", "toBase": 1 },
        { "id": "kib", "label": "kibibytes", "aliases": ["kb"], "order": 51, "since": 1, "dimension": "data", "toBase": 1024 },
        { "id": "mib", "label": "mebibytes", "aliases": ["mb"], "order": 52, "since": 1, "dimension": "data", "toBase": 1048576 },
        { "id": "gib", "label": "gibibytes", "aliases": ["gb"], "order": 53, "since": 1, "dimension": "data", "toBase": 1073741824 },

        { "id": "usd", "label": "US dollars", "aliases": ["dollars", "$"], "order": 60, "since": 1, "dimension": "currency", "toBase": 1 },
        { "id": "usd-per-1k", "label": "US dollars per 1,000 operations", "aliases": [], "order": 61, "since": 1, "dimension": "currency", "toBase": 0.001 },

        { "id": "score", "label": "score", "aliases": ["points"], "order": 70, "since": 1, "dimension": "score", "toBase": 1 }
