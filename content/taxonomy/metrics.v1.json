        { "id": "us", "label": "microseconds", "aliases": ["µs"], "order": 2, "since": 1, "dimension": "time", "toBase": 1e-6 },
        { "id": "ms", "label": "milliseconds", "aliases": ["millis"], "order": 3, "since": 1, "dimension": "time", "toBase": 0.001 },
        { "id": "s", "label": "seconds", "aliases": ["sec", "seconds"], "order": 4, "since": 1, "dimension": "time", "toBase": 1 },
        { "id": "min", "label": "minutes", "aliases": ["minutes"], "order": 5, "since": 1, "dimension": "time", "toBase": 60 },

        { "id": "rps", "label": "requests per second", "aliases": ["req/s", "qps"], "order": 10, "since": 1, "dimension": "rate", "toBase": 1 },
        { "id": "eps", "label": "events per second", "aliases": ["events/s"], "order": 11, "since": 1, "dimension": "rate", "toBase": 1 },
        { "id": "tps", "label": "tokens per second", "aliases": ["tok/s"], "order": 12, "since": 1, "dimension": "rate", "toBase": 1 },
        { "id": "opm", "label": "operations per minute", "aliases": ["ops/min"], "order": 13, "since": 1, "dimension": "rate", "toBase": 0.016666666666666666 },

        { "id": "mbps", "label": "megabits per second", "aliases": ["mbit/s"], "order": 20, "since": 1, "dimension": "data-rate", "toBase": 1000000 },
        { "id": "mibs", "label": "mebibytes per second", "aliases": ["mib/s"], "order": 21, "since": 1, "dimension": "data-rate", "toBase": 8388608 },

        { "id": "ratio", "label": "ratio", "aliases": ["fraction"], "order": 30, "since": 1, "dimension": "ratio", "toBase": 1 },
