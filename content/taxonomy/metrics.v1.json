{
  "$schema": "../schema/taxonomy.v1.schema.json",
  "vocabulary": "metrics",
  "version": 1,
  "closed": false,
  "description": "Metric categories and units. PRD 5.3.1: \"'Impact metric' is not a free-form filter. Metrics must be grouped into controlled categories ... Numeric comparison requires compatible units.\" Each unit therefore declares a dimension and a conversion factor to that dimension's base unit, and each category declares which dimensions it accepts. Rule MET-UNIT-001 enforces the pairing.",
  "groups": {
    "categories": {
      "label": "Metric category",
      "facetGroup": null,
      "order": 1,
      "terms": [
        { "id": "latency", "label": "Latency", "aliases": ["response-time", "duration"], "order": 1, "since": 1, "dimensions": ["time"] },
        { "id": "throughput", "label": "Throughput", "aliases": ["rps", "qps"], "order": 2, "since": 1, "dimensions": ["rate", "data-rate"] },
        { "id": "reliability", "label": "Reliability", "aliases": ["availability", "uptime"], "order": 3, "since": 1, "dimensions": ["ratio", "count", "time"] },
        { "id": "cost", "label": "Cost", "aliases": ["spend"], "order": 4, "since": 1, "dimensions": ["currency", "ratio"] },
        { "id": "quality", "label": "Quality", "aliases": ["accuracy", "recall", "precision"], "order": 5, "since": 1, "dimensions": ["ratio", "score"] },
        { "id": "accessibility", "label": "Accessibility", "aliases": ["a11y"], "order": 6, "since": 1, "dimensions": ["count", "ratio"] },
        { "id": "adoption", "label": "Adoption", "aliases": ["usage"], "order": 7, "since": 1, "dimensions": ["count", "ratio"] },
        { "id": "external-validation", "label": "External validation", "aliases": ["upstream"], "order": 8, "since": 1, "dimensions": ["count"] },
        { "id": "efficiency", "label": "Resource efficiency", "aliases": ["memory", "cpu"], "order": 9, "since": 1, "dimensions": ["data", "ratio", "count"] }
      ]
    },
    "units": {
